# Kymera environment configuration
# Copy to .env.local and fill in. Never commit real values.

# ---------------------------------------------------------------- REQUIRED

# Neon / Postgres connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signing key for the authentication cookie. MUST be a random string of at least
# 32 characters. In production the app refuses to issue sessions without it.
# Generate with: openssl rand -hex 32
KYMERA_AUTH_SECRET=""

# ---------------------------------------------------------------- EXECUTION

# Mainnet execution is OFF unless this is exactly "true". Leave unset for testnet-only
# operation. Turning it on lets Guard authorize BNB mainnet transactions with real funds.
# KYMERA_ENABLE_MAINNET="false"

# Dedicated RPC endpoints. Public defaults are used when unset, which is fine for a
# demo but rate-limited and unsuitable for production.
# BNB_TESTNET_RPC_URL=""
# BNB_MAINNET_RPC_URL=""

# ---------------------------------------------------------------- INTEGRATIONS

# WalletConnect. Without it only injected (EIP-6963) wallets are offered.
# This value is public by design.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# ERC-8004 registry indexing.
# NETWORK="bsc-testnet"                 # or bsc-mainnet (default)
# ERC8004_REGISTRY_ADDRESS=""           # overrides the built-in per-network default
# ERC8004_SCAN_API_URL=""               # defaults to https://www.8004scan.io/api/v1
# ERC8004_MAX_PAGES="10"
# NEXT_PUBLIC_ERC8004_IDENTITY_REGISTRY=""   # testnet ownerOf() identity checks

# PancakeSwap subgraph. The two built-in gateway endpoints usually require a key.
# THEGRAPH_API_KEY=""
# PANCAKESWAP_SUBGRAPH_URL=""
# PANCAKESWAP_SUBGRAPH_FALLBACK_URL=""

# ---------------------------------------------------------------- OPERATIONS

# Bearer token gating POST /api/agents/evaluate (batch evaluation + endpoint probing).
# The route is disabled entirely when this is unset.
# KYMERA_ADMIN_TOKEN=""

# Payment provider id. Only "demo" is implemented; it never charges anything.
# Setting an unregistered value fails closed rather than silently falling back.
# KYMERA_PAYMENT_PROVIDER="demo"
