# Kymera environment configuration
# Copy to .env.local and fill in. Never commit real values.

# ---------------------------------------------------------------- REQUIRED

# Neon / Postgres connection string. On Vercel's Neon integration this is usually the
# POOLED endpoint (host contains "-pooler").
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"

# Neon's UNPOOLED / direct connection string. Required for migrations: pgbouncer
# pooling (used by DATABASE_URL above) does not support the advisory locks
# `prisma migrate deploy` takes, and migrations will fail without this set.
# Same value as DATABASE_URL but without "-pooler" in the host.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signing key for the authentication cookie. MUST be a random string of at least
# 32 characters. In production the app refuses to issue sessions without it.
# Generate with: openssl rand -hex 32
KYMERA_AUTH_SECRET=""

# ---------------------------------------------------------------- EXECUTION

# Mainnet execution is OFF unless this is exactly "true". Leave unset for testnet-only
# operation. Turning it on lets Guard authorize BNB mainnet transactions with real funds.
# KYMERA_ENABLE_MAINNET="false"

# Dedicated RPC endpoints. Public defaults are used when unset, which is fine for a
# demo but rate-limited and unsuitable for production.
# BNB_TESTNET_RPC_URL=""
# BNB_MAINNET_RPC_URL=""

# ---------------------------------------------------------------- INTEGRATIONS

# WalletConnect. Without it only injected (EIP-6963) wallets are offered.
# This value is public by design.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# ERC-8004 registry indexing.
# NETWORK="bsc-testnet"                 # or bsc-mainnet (default)
# ERC8004_REGISTRY_ADDRESS=""           # overrides the built-in per-network default
# ERC8004_SCAN_API_URL=""               # defaults to https://www.8004scan.io/api/v1
# ERC8004_MAX_PAGES="10"
# NEXT_PUBLIC_ERC8004_IDENTITY_REGISTRY=""   # testnet ownerOf() identity checks

# Altana — non-custodial smart agentic wallets with on-chain session-key delegation.
#
# ALTANA_ADMIN_PRIVATE_KEY is the admin authority for Kymera's agent wallet. It is
# SERVER-ONLY: it must never appear in a NEXT_PUBLIC_ variable, never reach the browser,
# never be written to the database, never be returned by an API, and never be logged.
# The app refuses to start if it is exposed as NEXT_PUBLIC_ALTANA_ADMIN_PRIVATE_KEY.
#
# Use a DEDICATED BSC testnet wallet. Do not use a personal wallet — anything this key
# controls is at risk if the deployment is compromised.
#
#   Generate:  echo "0x$(openssl rand -hex 32)"
#   Fund the derived address from https://testnet.bnbchain.org/faucet-smart
#
# Session keys are NOT configured here and are never stored: they are derived
# deterministically from this key plus the Guard session id, so a database dump
# contains no signing material.
#
# Altana features report themselves unavailable, honestly, when this is unset.
# ALTANA_ADMIN_PRIVATE_KEY=""
# ALTANA_NETWORK="bnb-testnet"          # bnb-testnet (default) | bnb — mainnet also
#                                       # requires KYMERA_ENABLE_MAINNET="true"

# PancakeSwap subgraph. The two built-in gateway endpoints usually require a key.
# THEGRAPH_API_KEY=""
# PANCAKESWAP_SUBGRAPH_URL=""
# PANCAKESWAP_SUBGRAPH_FALLBACK_URL=""

# ---------------------------------------------------------------- OPERATIONS

# Bearer token gating POST /api/agents/evaluate (batch evaluation + endpoint probing).
# The route is disabled entirely when this is unset.
# KYMERA_ADMIN_TOKEN=""

# Payment provider id. Only "demo" is implemented; it never charges anything.
# Setting an unregistered value fails closed rather than silently falling back.
# KYMERA_PAYMENT_PROVIDER="demo"
