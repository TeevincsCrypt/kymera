generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id                 String              @id @default(cuid())
  name               String
  description        String
  category           String
  chain              String
  endpoint           String?
  ownerAddress       String
  registrationId     String?
  capabilities       Json
  supportedProtocols Json
  price              Decimal?            @db.Decimal(18, 8)
  verified           Boolean             @default(false)
  status             String              @default("Live")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  performance        AgentPerformance?
  tasks              AgentTask[]
  capabilityItems    AgentCapability[]
  transactions       AgentTransaction[]
  sessions           AgentSession[]
  benchmarkResults   BenchmarkResult[]
  hires             AgentHire[]
  erc8004ChainId     Int?
  erc8004RegistryAddress String?
  erc8004TokenId     String?
  erc8004MetadataUri String?
  erc8004MetadataHash String?
  erc8004LastSyncedAt DateTime?
  erc8004RawRegistration Json?

  @@unique([erc8004ChainId, erc8004RegistryAddress, erc8004TokenId])
  @@index([category])
  @@index([chain])
  @@index([status])
  @@index([verified])
  @@index([ownerAddress])
}

model AgentHire {
  id              String   @id @default(cuid())
  agentId         String
  userAddress     String
  status          String   @default("PENDING_PAYMENT")
  paymentProvider String
  paymentId       String?
  paymentStatus   String   @default("UNPAID")
  amount          Decimal  @db.Decimal(18, 8)
  currency        String   @default("USD")
  task            String
  benchmarkId     String?
  sessionId       String?
  requestedPermissions Json
  blockedActions  Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  paidAt          DateTime?
  activatedAt     DateTime?
  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([userAddress, status])
  @@index([agentId, createdAt])
}

model AgentPerformance {
  id                String   @id @default(cuid())
  agentId           String   @unique
  successRate       Float
  tasksCompleted    Int      @default(0)
  failedTasks       Int      @default(0)
  avgExecutionTime  Float
  totalVolume       Decimal  @default(0) @db.Decimal(18, 8)
  kymeraScore       Float
  lastEvaluatedAt   DateTime?
  agent             Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([kymeraScore])
}

model AgentTask {
  id             String   @id @default(cuid())
  agentId        String
  task           String
  status         String
  result         Json?
  executionTime  Float?
  cost           Decimal? @db.Decimal(18, 8)
  createdAt      DateTime @default(now())
  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, status])
}

model AgentCapability {
  id          String @id @default(cuid())
  agentId     String
  name        String
  description String?
  agent       Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

model AgentTransaction {
  id        String   @id @default(cuid())
  agentId   String
  txHash    String   @unique
  chain     String
  action    String
  amount    Decimal? @db.Decimal(18, 8)
  status    String
  timestamp DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, timestamp])
}

model AgentSession {
  id            String             @id @default(cuid())
  agentId       String
  userAddress   String
  spendingLimit Decimal?           @db.Decimal(18, 8)
  expiresAt     DateTime
  status        String
  createdAt     DateTime           @default(now())
  revokedAt     DateTime?
  mode          String             @default("SIMULATION")
  provider      String             @default("KYмERA_GUARD")
  walletAddress String?
  providerSessionId String?
  network       String?
  verificationUrl String?
  grantTxHash   String?
  agent         Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  permissions   AgentPermission[]
  auditLogs     AgentAuditLog[]

  @@index([agentId, status])
  @@index([userAddress])
}

model AgentPermission {
  id         String       @id @default(cuid())
  sessionId  String
  permission String
  allowed    Boolean      @default(false)
  session    AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model AltanaWallet {
  id          String   @id @default(cuid())
  address     String   @unique
  network     String
  mode        String
  createdAt   DateTime @default(now())
  sessions    AltanaSession[]
  executions  AltanaExecution[]
}

model AltanaSession {
  id                String   @id @default(cuid())
  walletId          String
  agentId           String
  allowedContracts  Json
  allowedMethods    Json
  spendingCap       Decimal? @db.Decimal(18, 8)
  expiry            DateTime
  status            String
  simulated         Boolean  @default(true)
  revokedAt         DateTime?
  createdAt         DateTime @default(now())
  wallet            AltanaWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  executions        AltanaExecution[]
  @@index([agentId, status])
}

model AltanaExecution {
  id              String   @id @default(cuid())
  agentId         String
  walletId        String
  sessionId       String
  action          String
  target          String
  value           Decimal? @db.Decimal(18, 8)
  status          String
  simulated       Boolean  @default(true)
  txHash          String?
  rejectionReason String?
  createdAt       DateTime @default(now())
  wallet          AltanaWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  session         AltanaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([agentId, createdAt])
}

model AgentJob {
  id          String   @id @default(cuid())
  chainId     Int
  network     String
  client      String
  provider    String
  evaluator   String
  budget      Decimal  @db.Decimal(18, 8)
  status      String
  simulated   Boolean  @default(true)
  txHash            String? @unique
  from              String?
  to                String?
  value             Decimal? @db.Decimal(18, 8)
  submittedAt       DateTime?
  confirmedAt       DateTime?
  blockNumber       BigInt?
  gasUsed           BigInt?
  effectiveGasPrice BigInt?
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([network, status])
}

model AgentAuditLog {
  id           String       @id @default(cuid())
  sessionId    String
  action       String
  actorAddress String?
  details      Json?
  createdAt    DateTime     @default(now())
  session      AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model Benchmark {
  id          String            @id @default(cuid())
  task        String
  status      String
  createdAt   DateTime          @default(now())
  completedAt DateTime?
  results     BenchmarkResult[]

  @@index([status])
}

model BenchmarkResult {
  id            String    @id @default(cuid())
  benchmarkId   String
  agentId       String
  accuracy      Float?
  executionTime Float?
  cost          Decimal?  @db.Decimal(18, 8)
  riskScore     Float?
  score         Float?
  capabilityMatch Float?
  taskRelevance Float?
  protocolMatch Float?
  metadataQuality Float?
  evaluationConfidence Float?
  reasoning     Json?
  result        Json?
  rank          Int?
  benchmark     Benchmark @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)
  agent         Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([benchmarkId, agentId])
  @@index([agentId])
}
